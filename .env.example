# Supabase — copy to .env and fill in from your project's API settings.
# These are safe to ship in the client; Row Level Security is the security boundary.
# Never put the service_role key in this app.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<publishable-key (sb_publishable_...) or legacy anon key>
