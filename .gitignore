# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Expo
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
*.expo.ts

# React Native / native build output
android/
ios/
.kotlin/
*.orig.*

# Signing credentials and provisioning files
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore

# Metro
.metro-health-check*

# Logs and debug output
logs/
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.log*

# macOS
.DS_Store
._*

# Certificates
*.pem

# Local environment files
.env
.env.*
.env*.local
!.env.example

# TypeScript
*.tsbuildinfo

# Build artifacts and coverage
build/
coverage/
.nyc_output/

# Vercel / deployment output
.vercel/

# Local editor and tooling noise
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Local nested-repo artifact; do not commit a second Git repository.
/Bloke/
